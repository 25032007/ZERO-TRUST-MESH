# ── Server ──────────────────────────────────────────────────────────────
PORT=4000

# ── Admin API ───────────────────────────────────────────────────────────
# Protects every /admin/* route (register service, rotate key, revoke token,
# release quarantine). If you leave this empty a random key is generated at
# startup and printed to the console — fine for local dev, NOT for production
# (it changes on every restart).
ADMIN_API_KEY=

# true  = dashboard, metrics, audit and simulator are readable without a key
#         (good for a public demo)
# false = they require the admin key too (use this in any real deployment)
PUBLIC_DASHBOARD=true

# ── Security tuning (all optional; defaults live in src/config.ts) ─────────
TOKEN_MAX_LIFETIME_SEC=900
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
QUARANTINE_MS=60000
RISK_MONITOR_AT=30
RISK_STEP_UP_AT=60
RISK_BLOCK_AT=80
BUSINESS_HOURS_START=6
BUSINESS_HOURS_END=22

# ── Policy as code ──────────────────────────────────────────────────────
# JSON policy file (priority, allow/deny effect, time windows, dry-run, workflows).
# An invalid file at startup stops the server; an invalid edit later is rejected
# and the previous policies stay active.
POLICY_FILE=policies/default.json
# Reload automatically when the file changes.
POLICY_WATCH=true
# true = log "would have blocked" for policy denials but let the request through
# (use this to roll out new policies safely before enforcing them).
DRY_RUN=false

# ── Risk engine ─────────────────────────────────────────────────────────
# baseline = per-service-pair rolling EWMA + z-score (default)
# fixed    = "N requests per 5 s" thresholds (kept for comparison/evaluation)
RISK_MODE=baseline
# Baseline tuning (defaults shown). A pair is not scored until it has seen
# BASELINE_MIN_WINDOWS full windows (warm-up), so new edges are never flagged.
BASELINE_WINDOW_MS=5000
BASELINE_ALPHA=0.2
BASELINE_MIN_WINDOWS=6
BASELINE_MIN_SPIKE=10
BASELINE_Z_WARN=3
BASELINE_Z_HIGH=6

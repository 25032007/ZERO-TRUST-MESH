{
  "name": "zero-trust-mesh",
  "version": "1.0.0",
  "description": "Zero-trust policy enforcement proxy for service-to-service traffic: Ed25519 workload identity, single-use tokens, default-deny policy, explainable risk scoring, lateral-movement detection, tamper-evident audit log.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "autocannon": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
